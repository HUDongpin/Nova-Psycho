# Service deployment. Copy outside version control; use a DIFFERENT file for CN and HK.
NOVA_MODE=service
NOVA_REGION=CN
NOVA_PUBLIC_URL=https://nova-cn.example.com
DATABASE_URL=postgresql://nova:REPLACE_WITH_RANDOM_PASSWORD@database:5432/nova
NOVA_REPORT_DIR=/var/lib/nova/reports
# Generate independently for each region: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
# Store the result directly in your secret manager, not logs. Losing this key makes existing PDFs unreadable.
NOVA_REPORT_KEY=REPLACE_WITH_64_HEX_CHARACTERS
NOVA_AI_ENABLED=false
# Enable only after configuring and independently verifying the same-region inference workspace.
NOVA_AI_DEPLOYMENT_SCOPE=CN
NOVA_AI_BASE_URL=
NOVA_AI_API_KEY=
NOVA_AI_MODEL=
# Docker image uses the same build for both regions.
NOVA_DIST_DIR=.next
POSTGRES_USER=nova
POSTGRES_DB=nova
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
NOVA_LOCAL_WEB_PORT=3100
